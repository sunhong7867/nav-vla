<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>thor_vehicle_pkg</name>
  <version>0.1.0</version>
  <description>
    Thor real-vehicle I/O for nav-vla: USB camera publisher and Arduino serial
    sender (ported from VLA_AD), plus the cmd_vel -&gt; MotionCommand adapter that
    lets the unchanged sim serving stack (vla_bridge /cmd_vel) drive the real
    car. VLA_AD's own stack stays untouched as baseline/demonstrator.
  </description>
  <maintainer email="tjsghd7867@g.skku.edu">sunhong7867</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>interfaces_pkg</depend>
  <depend>cv_bridge</depend>
  <depend>python3-serial</depend>
  <depend>python3-opencv</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

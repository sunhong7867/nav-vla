<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>track_localizer_pkg</name>
  <version>0.0.0</version>
  <description>External track-frame localization from a fixed trackside Hesai OT128: BEV vehicle detection, constant-velocity tracking, and pose publishing for the real-car stack.</description>
  <maintainer email="skku.boot2@gmail.com">sunhong</maintainer>
  <license>GPL-3</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Stock message types only: this package must build on the car with no
       interfaces_pkg present, and the two repos' interfaces_pkg disagree. -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
